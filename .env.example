# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Find these in your Sanity project dashboard at https://sanity.io/manage

# Your Sanity project ID (e.g. "abc12def")
VITE_SANITY_PROJECT_ID=

# Dataset name — typically "production"
VITE_SANITY_DATASET=production

# Sanity API version date (keep this pinned; update intentionally)
VITE_SANITY_API_VERSION=2024-01-01

# Scoped write token for community photo/video submissions.
# Create at: https://sanity.io/manage → project → API → Tokens
# Token permissions: Editor on "photoSubmission" document type only.
# This token is baked into the frontend bundle — keep it narrowly scoped.
VITE_SANITY_WRITE_TOKEN=
